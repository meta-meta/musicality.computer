% Extract resolved music after LilyPond has parsed relative pitches and repeats.
#(define event-port #f)
#(define (moment-beats moment)
   (* 4 (/ (ly:moment-main-numerator moment) (ly:moment-main-denominator moment))))
#(define (music-beats music) (moment-beats (ly:music-length music)))
#(define (note-midi note) (+ 60 (ly:pitch-semitones (ly:music-property note 'pitch))))
#(define (dump-event music at)
   (let* ((name (ly:music-property music 'name))
          (elements (ly:music-property music 'elements))
          (element (ly:music-property music 'element)))
     (cond
       ((eq? name 'GraceMusic) #t)
       ((eq? name 'UnfoldedRepeatedMusic)
        (let ((time at))
          (do ((pass 1 (+ pass 1))) ((> pass (ly:music-property music 'repeat-count)))
            (dump-event element time)
            (set! time (+ time (music-beats element)))
            (for-each (lambda (alt)
              (if (member pass (ly:music-property alt 'volta-numbers))
                (begin (dump-event alt time) (set! time (+ time (music-beats alt)))))) elements))))
       ((eq? name 'SequentialMusic)
        (let ((time at))
          (for-each (lambda (child) (dump-event child time) (set! time (+ time (music-beats child)))) elements)))
       ((or (eq? name 'EventChord) (eq? name 'NoteEvent))
        (let* ((notes (if (eq? name 'NoteEvent) (list music)
                          (filter (lambda (child) (eq? (ly:music-property child 'name) 'NoteEvent)) elements)))
               (pitches (map note-midi notes))
               (chord-notes (filter (lambda (note) (not (eq? #t (ly:music-property note 'bass)))) notes))
               (root (if (null? chord-notes) 60
                 (apply min (map (lambda (note) (- (note-midi note) (* 12 (ly:music-property note 'octavation 0)))) chord-notes))))
               (bass-note (find (lambda (note) (or (eq? #t (ly:music-property note 'bass)) (eq? #t (ly:music-property note 'inversion)))) notes))
               (ties (map (lambda (note) (any (lambda (a) (eq? (ly:music-property a 'name) 'TieEvent))
                                              (ly:music-property note 'articulations))) notes)))
          (if (not (null? pitches))
              (format event-port "{\"kind\":\"notes\",\"at\":~a,\"duration\":~a,\"notes\":[~a],\"ties\":[~a],\"root\":~a,\"bass\":~a,\"chordNotes\":[~a]}\n"
                (exact->inexact at) (exact->inexact (music-beats music))
                (string-join (map number->string pitches) ",")
                (string-join (map (lambda (tie) (if tie "true" "false")) ties) ",")
                root (if bass-note (note-midi bass-note) -1)
                (string-join (map (lambda (note) (number->string (note-midi note))) chord-notes) ",")))))
       ((eq? name 'TimeSignatureMusic)
        (format event-port "{\"kind\":\"meter\",\"at\":~a,\"numerator\":~a,\"denominator\":~a}\n"
          (exact->inexact at) (ly:music-property music 'numerator) (ly:music-property music 'denominator)))
       ((ly:music? element) (dump-event element at))
       ((pair? elements) (for-each (lambda (child) (dump-event child at)) elements)))))

exportEvents =
#(define-music-function (path music) (string? ly:music?)
   (set! event-port (open-output-file path))
   (dump-event music 0)
   (format event-port "{\"kind\":\"end\",\"at\":~a}\n" (exact->inexact (music-beats music)))
   (close-port event-port)
   (make-music 'SequentialMusic 'elements '()))
